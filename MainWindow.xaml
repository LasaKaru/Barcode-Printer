<Window x:Class="BarcodePrinterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode Sticker Printer" Height="680" Width="850">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <GroupBox Header="Label Settings (cm &amp; mm)" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="2">
                        <TextBlock Text="Label Width (cm):"/>
                        <TextBox x:Name="txtLabelWidth" Text="5.0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                        <TextBlock Text="Label Height (cm):"/>
                        <TextBox x:Name="txtLabelHeight" Text="2.5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="2">
                        <TextBlock Text="Barcode Width (cm):"/>
                        <TextBox x:Name="txtBcWidth" Text="3.5"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="2">
                        <TextBlock Text="Barcode Height (mm):"/>
                        <TextBox x:Name="txtBcHeight" Text="9.0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="2">
                        <TextBlock Text="Text Font Size (mm):"/>
                        <TextBox x:Name="txtFontSize" Text="5.0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Data Source (Excel)" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Excel File Path:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtExcelPath" Grid.Column="0" Margin="0,0,5,0" IsReadOnly="True"/>
                        <Button Content="Browse..." Grid.Column="1" Width="80" Click="BtnBrowseExcel_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Print Actions" Padding="10">
                <StackPanel>
                    <!-- NEW PRINTER SELECTION -->
                    <TextBlock Text="Select Printer:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbPrinters" Margin="0,5,0,15" Height="25"/>

                    <TextBlock Text="Manual Number Print:" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBox x:Name="txtManualCode" Width="150" Margin="0,0,10,0"/>
                        <Button Content="Preview" Width="80" Margin="0,0,5,0" Click="BtnPreview_Click"/>
                        <Button Content="Print Manual" Width="100" Click="BtnPrintManual_Click"/>
                    </StackPanel>

                    <TextBlock Text="Excel Bulk / Range Print:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBlock Text="Start Row:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtRangeStart" Width="50" Margin="0,0,15,0" Text="1"/>
                        <TextBlock Text="End Row:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtRangeEnd" Width="50" Margin="0,0,15,0" Text="10"/>
                        <Button Content="Print Range" Width="100" Click="BtnPrintRange_Click"/>
                    </StackPanel>

                    <Button Content="Print Test Label (Align Check)" Height="30" Margin="0,15,0,0" Click="BtnPrintTest_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Column="1" Header="Label Preview" Padding="10">
            <StackPanel>
                <TextBlock Text="Below is an approximate preview of a single 5cm x 2.5cm label." TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border BorderBrush="Gray" BorderThickness="1" Width="300" Height="150" HorizontalAlignment="Center">
                    <Image x:Name="imgPreview" Stretch="Uniform"/>
                </Border>
            </StackPanel>
            
        </GroupBox>
    </Grid>
</Window>